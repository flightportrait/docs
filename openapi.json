    "/v1/airport/{code}": {
      "get": {
        "tags": [
          "History"
        ],
        "summary": "Airport",
        "description": "Observed totals and busiest routes, plus an inferred departures board in local time. IATA or ICAO code. Circuits excluded. 404 if none.",
        "operationId": "airport",
        "parameters": [
          {
            "name": "code",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "IATA or ICAO airport code.",
              "title": "Code"
            },
            "description": "IATA or ICAO airport code."
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {},
                "example": {
                  "code": "SIN",
                  "departures": 120,
                  "destinations": 40,
                  "tails": 80,
                  "days_observed": 60,
                  "routes": [
                    {
                      "dst": "LHR",
                      "flights": 14,
                      "days": 7
                    }
                  ],
                  "board": [
                    {
                      "flight": "SQ322",
                      "dst": "LHR",
                      "dep": "09:00",
                      "arr": "15:10",
                      "type": "A359",
                      "flights": 12,
                      "source": "adsb"
                    }
                  ],
                  "airlines": [
                    {
                      "icao": "SIA",
                      "flights": 90
                    }
                  ],
                  "times": "local",
                  "window": "60"
                }
              }
            }
          },
          "429": {
            "description": "Rate limited. Per IP, 600 second window."
          },
          "404": {
            "description": "Not found."
          },
          "422": {
            "description": "Invalid path."
          }
        }
      }
    },
