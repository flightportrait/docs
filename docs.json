{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "FlightPortrait",
  "description": "Documentation for the FlightPortrait frame and network.",
  "colors": {
    "primary": "#B8402E",
    "light": "#D97462",
    "dark": "#9A3526"
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "https://flightportrait.com"
  },
  "appearance": {
    "default": "light"
  },
  "background": {
    "color": {
      "light": "#F5F1E6"
    }
  },
  "navigation": {
    "groups": [
      {
        "group": "FlightPortrait",
        "pages": ["introduction", "how-it-works"]
      },
      {
        "group": "Yours to run",
        "pages": ["diy/overview", "diy/firmware", "diy/byos", "diy/byod"]
      },
      {
        "group": "The network",
        "pages": [
          "network/overview",
          "network/feed",
          "network/data"
        ]
      },
      {
        "group": "API",
        "openapi": "openapi.json",
        "pages": [
          "api/reference",
          {
            "group": "Live",
            "pages": [
              "GET /v1/now",
              "GET /v1/aircraft",
              "GET /v1/trace/{hex}",
              "GET /v2/point/{lat}/{lon}/{radius}"
            ]
          },
          {
            "group": "History",
            "pages": [
              "GET /v1/airframes/{hex}",
              "GET /v1/flights/{callsign}",
              "GET /v1/airports/{code}"
            ]
          },
          {
            "group": "Stations",
            "pages": [
              "GET /v1/stations",
              "GET /v1/stations/{station_uuid}"
            ]
          },
          {
            "group": "Reference",
            "pages": [
              "GET /v1/airlines",
              "GET /v1/airlines/{icao}",
              "GET /v1/airlines/{icao}/routes",
              "GET /v1/airlines/{icao}/leg/{org}/{dst}",
              "GET /v1/airlines/{icao}/schedule/{org}/{dst}",
              "GET /v1/airlines/{icao}/countries",
              "GET /v1/airlines/{icao}/fleet",
              "GET /v1/airlines/{icao}/fleet/{designator}",
              "GET /v1/alliances",
              "GET /v1/alliances/{slug}",
              "GET /v1/alliances/{slug}/routes",
              "GET /v1/types/{designator}"
            ]
          }
        ]
      }
    ]
  },
  "navbar": {
    "links": [
      {
        "label": "Live map",
        "href": "https://flightportrait.com/network"
      },
      {
        "label": "GitHub",
        "href": "https://github.com/flightportrait"
      }
    ],
    "primary": {
      "type": "button",
      "label": "flightportrait.com",
      "href": "https://flightportrait.com"
    }
  },
  "footer": {
    "socials": {
      "github": "https://github.com/flightportrait",
      "website": "https://flightportrait.com"
    }
  },
  "contextual": {
    "options": ["copy", "download-spec"]
  },
  "redirects": [
    {
      "source": "/network/self-host",
      "destination": "/network/overview"
    }
  ]
}
